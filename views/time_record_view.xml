<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_tiempo_montaje_tree" model="ir.ui.view">
    <field name="name">costproduct.timerecord.tree</field>
    <field name="model">costproduct.timerecord</field>
    <field name="arch" type="xml">
      <tree>
        <field name="orden_fabricacion"/>
        <field name="empleado"/>
        <field name="tiempo_inicio"/>
        <field name="tiempo_final"/>
      </tree>
        <xpath expr="//div[@name='importar_tiempos_box']" position = "inside">
            <div class="oe_button_box" name="importar_tiempos_box">
                <button name="action_importar_tiempos" string="Importar Tiempos"
                        type = "object"
                        class="oe_stat_button"/>
            </div>
        </xpath>
    </field>
  </record>
</odoo>