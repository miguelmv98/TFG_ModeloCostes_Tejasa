<?xml version="1.0" encoding="utf-8"?>
<odoo>
      <record id="view_cp_inventory_report_header_tree" model="ir.ui.view">
        <field name="name">cp.inventory.report.header.tree</field>
        <field name="model">cp.inventory.report.header</field>
        <field name="arch" type="xml">
            <tree string="Reportes de Inventario" create="false">
                <header>
                    <button name="action_generate_inventory_report" string="Generar Inventario" type="object" display ="always" class="oe_stat_button"/>
                </header>
                <field name="name"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="price_per_kg"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>

  <record id="view_cp_inventory_report_header_form" model="ir.ui.view">
    <field name="name">cp.inventory.report.header.form</field>
    <field name="model">cp.inventory.report.header</field>
    <field name="arch" type="xml">
      <form string="Reporte de Inventario">
        <sheet>
          <group>
            <field name="name"/>
            <field name="start_date"/>
            <field name="end_date"/>
            <field name="price_per_kg"/>
            <field name="create_date" readonly="1"/>
          </group>
          <notebook>
            <page string="Detalle del Reporte">
              <field name="line_ids">
                <tree editable="bottom">
                  <field name="internal_reference"/>
                  <field name="product_name"/>
                  <field name="initial_amount"/>
                  <field name="initial_value"/>
                  <field name="final_amount"/>
                  <field name="final_value"/>
                  <field name="selling_price"/>
                  <field name="cost_price"/>
                  <field name="weight"/>
                  <field name="transport_cost"/>
                </tree>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

     <record id="action_cp_inventory_report_header" model="ir.actions.act_window">
        <field name="name">Reportes de Inventario</field>
        <field name="res_model">cp.inventory.report.header</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p>Desde aquí puedes ver los reportes generados o crear uno nuevo.</p>
        </field>
    </record>
</odoo>