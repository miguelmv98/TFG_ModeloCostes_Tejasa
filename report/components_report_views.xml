<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_bom_line_report_tree" model="ir.ui.view">
    <field name="name">cp.components.report.tree</field>
    <field name="model">cp.components.report</field>
    <field name="arch" type="xml">
      <tree create="false">
        <field name="product_code"/>
        <field name="product_name"/>
        <field name="line_amount"/>
        <field name="line_product_code"/>
        <field name="line_product_name"/>
        <field name="line_product_cost"/>
        <field name="line_product_weight"/>
      </tree>
    </field>
  </record>

  <record id="action_cp_components_report" model="ir.actions.act_window">
    <field name="name">Lista de Materiales</field>
    <field name="res_model">cp.components.report</field>
    <field name="view_mode">tree,pivot</field>
  </record>
</odoo>