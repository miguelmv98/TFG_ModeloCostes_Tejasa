<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_inventory_report_wizard_form" model="ir.ui.view">
    <field name="name">cp.inventory.report.wizard.form</field>
    <field name="model">cp.inventory.report.wizard</field>
    <field name="arch" type="xml">
      <form string="Generar reporte de inventario">
        <group>
          <field name="initial_date"/>
          <field name="final_date"/>
          <field name="price_per_kg"/>
          <field name="description"/>
        </group>
        <footer>
          <button string="Generar" type="object" name="action_confirm_generate_report" class="btn-primary"/>
          <button string="Cancelar" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <act_window
    id="action_inventory_report_wizard"
    name="Generar Reporte Inventario"
    res_model="cp.inventory.report.wizard"
    view_mode="form"
    target="new"/>
</odoo>